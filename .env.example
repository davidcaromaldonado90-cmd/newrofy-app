# Base de datos MySQL accesible desde Render. Nunca subas tu archivo .env real.
DB_HOST=host-de-tu-mysql
DB_PORT=3306
DB_USER=usuario_newrofy
DB_PASSWORD=contraseña_segura
DB_NAME=newrofy_db

# Sesión Flask: usa un valor largo y aleatorio en producción.
SECRET_KEY=valor_aleatorio_largo

# Opcional: habilita recuperación por correo con un SMTP real.
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_USER=correo@tu-dominio.com
MAIL_PASSWORD=token_smtp
MAIL_FROM=correo@tu-dominio.com
